# Arcade Vault — variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# .env.local NO se versiona (ver .gitignore).

# Clave de API de Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Remitente de los correos de contacto.
# onboarding@resend.dev es el remitente de pruebas de Resend: solo entrega
# a la direccion de la propia cuenta. Cambia este valor por una direccion de
# un dominio verificado cuando exista, sin tocar codigo.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Direccion del equipo que recibe los mensajes del formulario de contacto.
CONTACT_TO_EMAIL=

# Contrasena de la base de datos, para conectarse con herramientas externas
# (psql, un cliente grafico, la CLI de Supabase). NINGUN codigo de la app la lee.
SUPABASE_DB_PASSWORD=

# --- Supabase ---------------------------------------------------------------
# Estas DOS variables son publicas a proposito: llevan el prefijo NEXT_PUBLIC_
# porque el cliente de Supabase corre en el navegador y acaban en el bundle.
# Lo que protege los datos NO es esconderlas, es la RLS de la tabla profiles.
# Es lo contrario de RESEND_API_KEY, que nunca puede salir del servidor.
#
# Se usa la clave PUBLICABLE (sb_publishable_...), no la clave anon heredada:
# se rota de forma independiente y es la recomendada para proyectos nuevos.
# Ambas estan en el panel: Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NUNCA anadir aqui una clave de servicio (service_role / sb_secret_...):
# ningun camino de codigo de esta app necesita saltarse la RLS.
